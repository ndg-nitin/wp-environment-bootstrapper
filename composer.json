{
    "name": "ndg-nitin/wp-environment-bootstrapper",
    "description": "Reproducible WordPress development environments from a JSON configuration file and a single WP-CLI command.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/ndg-nitin/wp-environment-bootstrapper",
    "authors": [
        {
            "name": "ndg-nitin",
            "email": "niting@axioned.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ndg-nitin/wp-environment-bootstrapper/issues",
        "source": "https://github.com/ndg-nitin/wp-environment-bootstrapper"
    },
    "keywords": [
        "wordpress",
        "wp-cli",
        "bootstrap",
        "development",
        "environment",
        "scaffolding"
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "WpEnvironment\\": "src/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
