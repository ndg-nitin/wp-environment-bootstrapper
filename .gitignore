# Dependencies
/vendor/

# Local configuration and secrets - never commit these
/config/setup.json
/secrets/env.json

# Legacy configuration files from the original project (contain credentials)
/setup.json
/env.json

# Safety net: WordPress projects are created NEXT to this repository (e.g. ../project),
# never inside it - but never commit a stray installation by accident.
/wordpress/
/wp-config.php

# Archives and backups must never be committed
*.zip
*.wpress

# Logs
*.log

# Operating system / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
